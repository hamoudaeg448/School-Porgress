# MySQL connection string (copy from hPanel > Databases)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"

# Long random string, e.g. run: openssl rand -base64 32
SESSION_SECRET="change-me"

# First admin account, used by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@school.test"
SEED_ADMIN_PASSWORD="change-this-password"
